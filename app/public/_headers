# Cache rules for static hosts (Cloudflare Pages and Netlify read this file).
# Same rules as serve.json, which Railway uses: the page and service worker are
# always rechecked so updates reach buyers; hashed assets are cached for a year.
/
  Cache-Control: no-cache, must-revalidate
/index.html
  Cache-Control: no-cache, must-revalidate
/sw.js
  Cache-Control: no-cache, must-revalidate
/manifest.webmanifest
  Cache-Control: no-cache, must-revalidate
/assets/*
  Cache-Control: public, max-age=31536000, immutable
